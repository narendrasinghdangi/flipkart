{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://flipkart-backend-eight.vercel.app/api/:path*" },
    { "source": "/health", "destination": "https://flipkart-backend-eight.vercel.app/api/health" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
