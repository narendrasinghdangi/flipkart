# Vite env (VITE_* values are bundled into the public JS – never put secrets here)

# Base URL the browser uses for API calls. "/api" goes through the Vite dev proxy / same-origin reverse proxy.
# For a separately hosted API use its full URL, e.g. https://api.yourdomain.com/api (and add this site to the backend CLIENT_ORIGIN).
VITE_API_BASE=/api

# Where the Vite dev server proxies /api to (dev only).
VITE_API_PROXY_TARGET=http://localhost:4000
